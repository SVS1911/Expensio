# SQL Server (install ODBC Driver 18 for SQL Server for local Python development)
SQLSERVER_DATABASE=ExpenseTracker
SQLSERVER_PASSWORD=Replace-with-a-strong-SQL-Server-password
SQLSERVER_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=localhost,1433;Database=ExpenseTracker;UID=sa;PWD=Replace-with-a-strong-SQL-Server-password;Encrypt=yes;TrustServerCertificate=yes
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CORS_ORIGINS=http://localhost:5173
# Optional registry image for server deployment; leave at default for local builds.
CONTAINER_IMAGE=ghcr.io/svs1911/travelanddailyexpencetracker:latest

# Optional email notifications (leave blank if not configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Leave blank to choose securely from SMTP_PORT (465 = TLS, other ports = STARTTLS).
# Set either variable to true/false to override the automatic mode.
SMTP_USE_TLS=
SMTP_START_TLS=

# Optional frontend build-time variable for a separate API origin.
# VITE_API_URL=
