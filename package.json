{
  "name": "expense-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:client\" \"npm:dev:api\"",
    "dev:client": "vite",
    "dev:api": "python -m uvicorn server.main:app --reload --port 8000",
    "migrate:json": "python scripts/import_json.py",
    "migrate:sqlite": "python scripts/migrate_sqlite_to_sqlserver.py",
    "build": "vite build",
    "start": "python -m uvicorn server.main:app --host 0.0.0.0 --port 8000"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^6.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
